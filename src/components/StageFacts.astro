---
/** The Who / In / Out strip at the top of each stage. */
interface Props {
	tone: 'you' | 'agent' | 'tool' | 'client' | 'you-agent' | 'agent-tool' | 'client-you';
	who: string;
	input: string;
	output: string;
}
import { t } from '../i18n/ui';
const { tone, who, input, output } = Astro.props;
const T = t(Astro);
---

<div class={`stage-facts is-${tone} not-content`}>
	<span>{T.who}</span><span set:html={who} />
	<span>{T.in}</span><span set:html={input} />
	<span>{T.out}</span><span set:html={output} />
</div>
