---
/**
 * §5 "Two kinds of memory": the weights (what training saw, and how often:
 * a probability spread over remembered answers) and the context window (a desk with limited space). Put real files
 * on the desk and read their contents; the answer then cites the exact line
 * it used, highlighted in the file. Overfill the desk and older items fall
 * off. pubspec.yaml and the lib/ listing are the real Mood Tracker handover;
 * the ADR and the chat are the course's illustrative documents.
 * English and Polish.
 */
import { langOf } from '../i18n/ui';
const lang = langOf(Astro);

type Doc = { key: string; name: string; kind: string; size: number; start: number; lines: string[]; more?: string };
const pubspec: string[] = [
	'dependencies:',
	'  flutter:',
	'    sdk: flutter',
	'  cupertino_icons: ^1.0.8',
	'  flutter_riverpod: ^2.6.1',
	'  intl: ^0.19.0',
	'  uuid: ^4.5.1',
	'  sqflite: ^2.4.1',
	'  path: ^1.9.0',
	'  http: ^1.2.2',
	'  flutter_secure_storage: ^9.2.3',
];
const adr: string[] = [
	'# ADR-0003: The app version comes from --dart-define',
	'Status: accepted',
	'',
	'## Context',
	'The About screen must show the app version. package_info_plus',
	'could read it, but it is one more SOUP item to register and',
	'maintain, for a single string.',
	'',
	'## Decision',
	'Read APP_VERSION with String.fromEnvironment and set it with',
	'--dart-define at build time. Default: "dev".',
];
const docsFlutter: string[] = [
	'StatefulWidget class',
	'A widget that has mutable state.',
	'',
	'State is information that (1) can be read synchronously when',
	'the widget is built and (2) might change during the lifetime',
	'of the widget. […] call State.setState to notify the',
	'framework that the internal state has changed.',
];
const lib: string[] = [
	'lib/',
	'  main.dart  config.dart',
	'  data/      database_helper.dart  mood_repository.dart',
	'  models/    mood_entry.dart',
	'  providers/ auth_provider.dart  mood_provider.dart',
	'  screens/   home  add_mood  mood_detail  stats  login  register',
	'  services/  api_client  auth_service  mood_api_service',
	'  widgets/   mood_card  mood_score_indicator',
];

const copy = {
	en: {
		kicker: 'The memory desk',
		weights: 'Weights: vague memory', weightsSub: 'compressed from training, frozen at the cut-off',
		desk: 'Context window: the desk', deskSub: 'exact text, current, limited',
		empty: 'The desk is empty: the model has only your question and its vague memory.',
		shelf: 'Put on the desk:', answer: 'Answer', from: 'from',
		fromW: 'vague memory', fromC: 'the desk',
		used: 'Used', remove: 'Take off the desk',
		dropped: 'Fell off the desk, the context was full: {d}.',
		q: 'Question',
		cap: 'context used: ≈{u}k of {c}k tokens',
		capNote: 'A tiny window, to make the point. Real ones hold 100k tokens or more, and a whole repository or a long chat still fills them.',
		seen: 'In training data', recalls: 'What the weights recall', illus: 'Illustrative probabilities.',
		freq: { often: 'very often, always the same', mixed: 'often, in many conflicting versions', never: 'never: your files are private' },
		overridden: '📄 The answer is copied from the desk. The vague memory is not needed.',
		recall: [
			{ freq: 'often', note: 'Thousands of tutorials say the same thing, so the memory is peaked and right.', cands: [['mutable state + setState()', 0.86, 1], ['a widget that never changes', 0.07, 0], ['a Riverpod provider', 0.04, 0], ['a kind of route', 0.03, 0]] },
			{ freq: 'mixed', note: 'Every version ever released appears somewhere, and older tutorials outnumber new ones. The most common one wins, not the one in your project.', cands: [['http 0.13.x', 0.38, 0], ['http 1.1.x', 0.22, 0], ['http 1.2.x', 0.18, 1], ['http 0.12.x', 0.12, 0], ['http 1.0.x', 0.10, 0]] },
			{ freq: 'never', note: 'Your decision record was never in the training data. The weights only hold generic reasons why people drop packages, so the model picks one.', cands: [['it is deprecated', 0.29, 0], ['security issues', 0.24, 0], ['it increases app size', 0.19, 0], ['it does not work on web', 0.15, 0], ['licence problems', 0.13, 0]] },
		],
		docs: [
			{ key: 'pubspec', name: 'pubspec.yaml', kind: 'yaml', size: 0.3, start: 10, lines: pubspec, more: '(lines 1–9 and 21–33 not shown)' },
			{ key: 'adr', name: 'docs/adr/0003-app-version-from-build.md', kind: 'md', size: 0.4, start: 1, lines: adr, more: '## Consequences …' },
			{ key: 'flutterdocs', name: 'api.flutter.dev › StatefulWidget', kind: 'web', size: 2, start: 1, lines: docsFlutter, more: '… the rest of the page' },
			{ key: 'chat', name: 'yesterday’s chat (dark mode)', kind: 'chat', size: 6, start: 1, lines: ['you: can we add a dark mode toggle?', 'assistant: Sure. Here is a plan in four steps: …', 'you: the colours look wrong on the stats screen', 'assistant: Let us check the ThemeData in main.dart …'], more: '… 212 more messages' },
			{ key: 'lib', name: 'the whole lib/ folder', kind: 'dir', size: 12, start: 1, lines: lib, more: '18 files, 1,377 lines of Dart' },
		] as Doc[],
		questions: [
			{ key: 'q1', text: 'What is a StatefulWidget in Flutter?', needs: 'flutterdocs', hit: [2, 4, 5, 6, 7],
				weights: { text: 'A widget whose state can change: the state lives in a separate State object, and calling setState() rebuilds it.', grade: 'good', tag: 'General, well-known knowledge: the vague memory is good enough here.' },
				context: { text: 'A widget that has mutable state; you call setState to tell the framework that the state changed.', grade: 'good', tag: 'Same answer, now with a source you can open.' } },
			{ key: 'q2', text: 'Which version of the http package does the Mood Tracker use?', needs: 'pubspec', hit: [19],
				weights: { text: 'The Mood Tracker most likely uses http 0.13.x, the common version in Flutter apps.', grade: 'vague', tag: 'A plausible guess from old training data. Confident, and wrong.' },
				context: { text: 'http: ^1.2.2', grade: 'good', tag: 'Read from the file, with file and line.' } },
			{ key: 'q3', text: 'Why doesn’t the Mood Tracker use package_info_plus?', needs: 'adr', hit: [5, 6, 7, 10, 11],
				weights: { text: 'Because package_info_plus is deprecated and has known security issues.', grade: 'invented', tag: 'Invented. The model never saw your decision, so it made up a reason that sounds right.' },
				context: { text: 'It would be one more SOUP item to register and maintain for a single string, so the version comes from --dart-define (APP_VERSION).', grade: 'good', tag: 'The real reason, from the decision record.' } },
		],
		grades: { good: 'sharp', vague: 'vague', invented: 'invented' },
	},
	pl: {
		kicker: 'Biurko pamięci',
		weights: 'Wagi: mglista pamięć', weightsSub: 'skompresowane z treningu, zamrożone w dniu odcięcia wiedzy',
		desk: 'Context window: biurko', deskSub: 'dokładny i aktualny tekst, ale mało miejsca',
		empty: 'Biurko jest puste: model ma tylko twoje pytanie i mglistą pamięć.',
		shelf: 'Połóż na biurku:', answer: 'Odpowiedź', from: 'z',
		fromW: 'mglistej pamięci', fromC: 'biurka',
		used: 'Użyte', remove: 'Zdejmij z biurka',
		dropped: 'Spadło z biurka, bo kontekst był pełny: {d}.',
		q: 'Pytanie',
		cap: 'zajęty kontekst: ≈{u}k z {c}k tokenów',
		capNote: 'Celowo malutkie okno. Prawdziwe mieszczą 100k tokenów i więcej, a i tak zapełnia je całe repozytorium albo długi czat.',
		seen: 'W danych treningowych', recalls: 'Co pamiętają wagi', illus: 'Przykładowe prawdopodobieństwa.',
		freq: { often: 'bardzo często, zawsze to samo', mixed: 'często, w wielu sprzecznych wersjach', never: 'nigdy: twoje pliki są prywatne' },
		overridden: '📄 Odpowiedź pochodzi wprost z biurka. Mglista pamięć nie jest potrzebna.',
		recall: [
			{ freq: 'often', note: 'Tysiące tutoriali mówią to samo, więc pamięć jest wyraźna i trafna.', cands: [['zmienny stan + setState()', 0.86, 1], ['widget, który się nie zmienia', 0.07, 0], ['provider z Riverpoda', 0.04, 0], ['rodzaj trasy (route)', 0.03, 0]] },
			{ freq: 'mixed', note: 'Każda kiedykolwiek wydana wersja gdzieś się pojawia, a starych tutoriali jest więcej niż nowych. Wygrywa najczęstsza, a nie ta z twojego projektu.', cands: [['http 0.13.x', 0.38, 0], ['http 1.1.x', 0.22, 0], ['http 1.2.x', 0.18, 1], ['http 0.12.x', 0.12, 0], ['http 1.0.x', 0.10, 0]] },
			{ freq: 'never', note: 'Waszego zapisu decyzji nigdy nie było w danych treningowych. Wagi pamiętają tylko ogólne powody, dla których ludzie rezygnują z pakietów, więc model wybiera jeden z nich.', cands: [['jest przestarzały', 0.29, 0], ['problemy z bezpieczeństwem', 0.24, 0], ['zwiększa rozmiar aplikacji', 0.19, 0], ['nie działa w wersji web', 0.15, 0], ['problemy z licencją', 0.13, 0]] },
		],
		docs: [
			{ key: 'pubspec', name: 'pubspec.yaml', kind: 'yaml', size: 0.3, start: 10, lines: pubspec, more: '(linie 1–9 i 21–33 pominięte)' },
			{ key: 'adr', name: 'docs/adr/0003-app-version-from-build.md', kind: 'md', size: 0.4, start: 1, lines: adr, more: '## Consequences …' },
			{ key: 'flutterdocs', name: 'api.flutter.dev › StatefulWidget', kind: 'web', size: 2, start: 1, lines: docsFlutter, more: '… reszta strony' },
			{ key: 'chat', name: 'wczorajszy czat (dark mode)', kind: 'chat', size: 6, start: 1, lines: ['ty: dodamy przełącznik dark mode?', 'asystent: Jasne. Oto plan w czterech krokach: …', 'ty: kolory na ekranie statystyk wyglądają źle', 'asystent: Sprawdźmy ThemeData w main.dart …'], more: '… jeszcze 212 wiadomości' },
			{ key: 'lib', name: 'cały folder lib/', kind: 'dir', size: 12, start: 1, lines: lib, more: '18 plików, 1377 linii Darta' },
		] as Doc[],
		questions: [
			{ key: 'q1', text: 'Czym jest StatefulWidget we Flutterze?', needs: 'flutterdocs', hit: [2, 4, 5, 6, 7],
				weights: { text: 'To widget, którego stan może się zmieniać: stan żyje w osobnym obiekcie State, a wywołanie setState() przebudowuje widget.', grade: 'good', tag: 'Ogólna, dobrze znana wiedza: tu mglista pamięć wystarczy.' },
				context: { text: 'Widget, który ma zmienny stan; wywołujesz setState, żeby poinformować framework, że stan się zmienił.', grade: 'good', tag: 'Ta sama odpowiedź, teraz ze źródłem, które możesz otworzyć.' } },
			{ key: 'q2', text: 'Której wersji pakietu http używa Mood Tracker?', needs: 'pubspec', hit: [19],
				weights: { text: 'Mood Tracker najpewniej używa http 0.13.x, powszechnie używanej wersji w aplikacjach Fluttera.', grade: 'vague', tag: 'Wiarygodnie brzmiący strzał na podstawie starych danych treningowych. Pewny siebie i błędny.' },
				context: { text: 'http: ^1.2.2', grade: 'good', tag: 'Odczytane z pliku, z podaniem pliku i linii.' } },
			{ key: 'q3', text: 'Dlaczego Mood Tracker nie używa package_info_plus?', needs: 'adr', hit: [5, 6, 7, 10, 11],
				weights: { text: 'Bo package_info_plus jest przestarzały i ma znane problemy z bezpieczeństwem.', grade: 'invented', tag: 'Zmyślone. Model nigdy nie widział waszej decyzji, więc wymyślił powód, który dobrze brzmi.' },
				context: { text: 'Byłby kolejnym elementem SOUP do zarejestrowania i utrzymywania, a chodzi o jeden napis, więc wersja pochodzi z --dart-define (APP_VERSION).', grade: 'good', tag: 'Prawdziwy powód, z zapisu decyzji.' } },
		],
		grades: { good: 'precyzyjna', vague: 'mglista', invented: 'zmyślona' },
	},
}[lang];
const CAP = 16;
const icon: Record<string, string> = { yaml: '📄', md: '📝', web: '🌐', chat: '💬', dir: '📁' };
---

<div class="biz-widget desk not-content" data-copy={JSON.stringify(copy)} data-cap={CAP}>
	<p class="biz-kicker">{copy.kicker}</p>
	<div class="desk__qs" role="tablist">
		{copy.questions.map((q, k) => <button type="button" role="tab" class="desk__q" data-i={k} aria-selected={k === 1 ? 'true' : 'false'}><span>{copy.q} {k + 1}</span>{q.text}</button>)}
	</div>
	<div class="desk__shelf">
		<span class="sdlc-legend__hint">{copy.shelf}</span>
		{copy.docs.map((d) => <button type="button" class="desk__doc" data-key={d.key} aria-pressed="false">{`${icon[d.kind]} ${d.name}`} <small>{`≈${d.size}k`}</small></button>)}
	</div>
	<div class="desk__grid">
		<div class="desk__weights">
			<p class="desk__title">{`🧠 ${copy.weights}`}</p>
			<p class="desk__sub">{copy.weightsSub}</p>
			<p class="desk__over">{copy.overridden}</p>
			<p class="desk__mini">{copy.seen}</p>
			<p class="desk__freq"><i></i><span></span></p>
			<p class="desk__mini">{copy.recalls}</p>
			<div class="desk__recall"></div>
			<p class="desk__rnote"></p>
			<p class="desk__illus">{copy.illus}</p>
		</div>
		<div class="desk__ctx">
			<p class="desk__title">{`🗂️ ${copy.desk}`}</p>
			<p class="desk__sub">{copy.deskSub}</p>
			<div class="desk__cap"><i></i><span></span></div>
			<div class="desk__files">
				{
					copy.docs.map((d) => (
						<figure class="desk__file" data-key={d.key} hidden>
							<figcaption>
								<span>{`${icon[d.kind]} ${d.name}`}</span>
								<button type="button" class="desk__x" data-key={d.key} aria-label={copy.remove} title={copy.remove}>×</button>
							</figcaption>
							<pre>{d.lines.map((l, j) => <span class="desk__line" data-n={d.start + j}><i>{d.kind === 'chat' || d.kind === 'dir' || d.kind === 'web' ? '' : d.start + j}</i>{l || ' '}</span>)}{d.more && <span class="desk__more">{d.more}</span>}</pre>
						</figure>
					))
				}
				<p class="desk__empty">{copy.empty}</p>
			</div>
			<p class="desk__capnote">{copy.capNote}</p>
		</div>
	</div>
	<div class="desk__answer" aria-live="polite">
		<p class="desk__ahead"><b>{copy.answer}</b> <span class="desk__from"></span> <span class="desk__grade"></span></p>
		<p class="desk__text"></p>
		<p class="desk__src"></p>
		<p class="desk__tag"></p>
		<p class="desk__drop"></p>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.desk').forEach((box) => {
		const C = JSON.parse(box.dataset.copy || '{}');
		const CAP = Number(box.dataset.cap);
		const qs = Array.from(box.querySelectorAll<HTMLButtonElement>('.desk__q'));
		const docsBtns = Array.from(box.querySelectorAll<HTMLButtonElement>('.desk__doc'));
		const files = box.querySelector<HTMLElement>('.desk__files')!;
		let q = 1;
		let onDesk: string[] = [];
		let dropped = '';
		const doc = (k: string) => C.docs.find((d: any) => d.key === k);
		const used = () => onDesk.reduce((a, k) => a + doc(k).size, 0) + 0.2;
		const fmt = (n: number) => (Math.round(n * 10) / 10).toString();
		const render = () => {
			const Q = C.questions[q];
			qs.forEach((b, j) => b.setAttribute('aria-selected', j === q ? 'true' : 'false'));
			docsBtns.forEach((b) => b.setAttribute('aria-pressed', onDesk.includes(b.dataset.key!) ? 'true' : 'false'));
			// Newest file on top.
			box.querySelectorAll<HTMLElement>('.desk__file').forEach((f) => (f.hidden = !onDesk.includes(f.dataset.key!)));
			onDesk.forEach((k) => files.prepend(box.querySelector(`.desk__file[data-key="${k}"]`)!));
			// The file the answer uses goes on top.
			if (onDesk.includes(Q.needs)) files.prepend(box.querySelector(`.desk__file[data-key="${Q.needs}"]`)!);
			box.querySelectorAll<HTMLElement>('.desk__line').forEach((l) => {
				const f = l.closest<HTMLElement>('.desk__file')!;
				l.classList.toggle('is-hit', f.dataset.key === Q.needs && Q.hit.includes(Number(l.dataset.n)));
			});
			box.querySelectorAll<HTMLElement>('.desk__file').forEach((f) => f.classList.toggle('is-key', f.dataset.key === Q.needs));
			box.querySelector<HTMLElement>('.desk__empty')!.hidden = onDesk.length > 0;
			const u = used();
			box.querySelector<HTMLElement>('.desk__cap i')!.style.width = `${Math.min(100, (u / CAP) * 100)}%`;
			box.querySelector<HTMLElement>('.desk__cap span')!.textContent = String(C.cap).replace('{u}', fmt(u)).replace('{c}', String(CAP));
			const fromCtx = onDesk.includes(Q.needs);
			const R = C.recall[q];
			const wbox = box.querySelector<HTMLElement>('.desk__weights')!;
			wbox.dataset.freq = R.freq;
			wbox.classList.toggle('is-over', fromCtx);
			wbox.querySelector<HTMLElement>('.desk__freq span')!.textContent = C.freq[R.freq];
			wbox.querySelector<HTMLElement>('.desk__rnote')!.textContent = R.note;
			const rec = wbox.querySelector<HTMLElement>('.desk__recall')!;
			rec.textContent = '';
			const top = Math.max(...R.cands.map((c: any[]) => c[1]));
			R.cands.forEach(([label, p, ok]: [string, number, number], j: number) => {
				const row = document.createElement('div');
				row.className = 'desk__rrow' + (p === top ? ' is-top' : '') + (ok ? ' is-true' : '');
				row.innerHTML = '<span class="desk__rlabel"></span><b></b><span class="desk__rbar"><i></i></span>';
				row.querySelector<HTMLElement>('.desk__rlabel')!.textContent = label;
				row.querySelector('b')!.textContent = `${Math.round(p * 100)}%`;
				rec.appendChild(row);
				requestAnimationFrame(() => (row.querySelector<HTMLElement>('.desk__rbar i')!.style.width = `${(p / top) * 100}%`));
			});
			const A = fromCtx ? Q.context : Q.weights;
			box.querySelector<HTMLElement>('.desk__from')!.textContent = `${C.from} ${fromCtx ? C.fromC : C.fromW}`;
			const g = box.querySelector<HTMLElement>('.desk__grade')!;
			g.textContent = C.grades[A.grade];
			g.className = `desk__grade is-${A.grade}`;
			const t = box.querySelector<HTMLElement>('.desk__text')!;
			t.textContent = A.text;
			t.className = `desk__text is-${A.grade}`;
			const src = box.querySelector<HTMLElement>('.desk__src')!;
			if (fromCtx) {
				const d = doc(Q.needs);
				const lines = Q.hit as number[];
				const where = d.kind === 'web' ? d.name : `${d.name}:${lines.length > 1 ? `${lines[0]}–${lines[lines.length - 1]}` : lines[0]}`;
				src.textContent = `${C.used}: ${where}`;
			} else src.textContent = '';
			box.querySelector<HTMLElement>('.desk__tag')!.textContent = A.tag;
			box.querySelector<HTMLElement>('.desk__drop')!.textContent = dropped ? String(C.dropped).replace('{d}', dropped) : '';
		};
		const toggle = (k: string) => {
			dropped = '';
			if (onDesk.includes(k)) onDesk = onDesk.filter((x) => x !== k);
			else {
				onDesk.push(k);
				while (used() > CAP && onDesk.length > 1) {
					const out = onDesk.shift()!;
					dropped = dropped ? `${dropped}, ${doc(out).name}` : doc(out).name;
				}
			}
			render();
		};
		qs.forEach((b, j) => b.addEventListener('click', () => { q = j; dropped = ''; render(); }));
		docsBtns.forEach((b) => b.addEventListener('click', () => toggle(b.dataset.key!)));
		box.querySelectorAll<HTMLButtonElement>('.desk__x').forEach((b) => b.addEventListener('click', () => toggle(b.dataset.key!)));
		render();
	});
</script>
