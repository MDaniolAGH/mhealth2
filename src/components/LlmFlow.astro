---
/**
 * "The model inside a harness": an animated, step-by-step diagram of one
 * request. You → harness builds the context → tokenizer → transformer →
 * probabilities and sampling → (loop) → a tool call caught by the harness →
 * the tool runs → its result goes back into the context → final answer.
 * Switch the harness off to see the same question answered without tools.
 * Text in English and Polish (picked from the page URL).
 */
import { langOf } from '../i18n/ui';
const lang = langOf(Astro);

const copy = {
	en: {
		kicker: 'Interactive diagram',
		title: 'One question, end to end',
		play: '▶ Play', pause: '❚❚ Pause', prev: '◀', next: '▶', reset: 'Start again',
		harnessOn: 'Harness with tools', harnessOff: 'Model only (chat)',
		step: 'Step {n} of {total}',
		ctx: 'Context window', out: 'What you see',
		nodes: { you: 'You', harness: 'Harness', tok: 'Tokenizer', model: 'Transformer', sample: 'Sampling', tools: 'Tools', detok: 'Detokenizer' },
		subs: { harness: 'builds the context, runs tools', tok: 'text → token IDs', model: 'billions of parameters', sample: 'pick the next token', tools: 'read · run · search', detok: 'tokens → text' },
		blocks: { sys: 'system prompt', agents: 'AGENTS.md', user: 'Do the tests pass?', call: 'run_command("flutter test")', result: '00:05 +33: All tests passed!', answer: 'Yes: all 33 tests pass (flutter test).', fake: 'Yes, all tests pass.' },
		steps: [
			'You type a question: <b>“Do the tests pass?”</b>',
			'The <b>harness</b> builds the context: its own system prompt, your <code>AGENTS.md</code>, then your message. The model will see only this.',
			'The <b>tokenizer</b> turns the whole context into token IDs: thousands of them for a real project.',
			'The <b>transformer</b> reads every token at once, through dozens of layers, and computes one thing: a probability for every possible next token.',
			'<b>Sampling</b> picks one token, here <code>I’ll</code>. That is the only output of one pass.',
			'The token is appended to the context, and everything runs again for the next token. <b>One token at a time</b>, the model writes: <i>I’ll run the tests.</i>',
			'Now the model writes a special <b>tool call</b>: <code>run_command("flutter test")</code>. The model cannot run anything. It only writes text that asks for it.',
			'The <b>harness</b> recognises the tool call and runs the command on your machine, with your permissions.',
			'The tool’s output goes <b>back into the context</b>: <code>00:05 +33: All tests passed!</code> Real evidence, not a guess.',
			'The model reads the context again, now with the result in it, and writes the answer token by token.',
			'The <b>detokenizer</b> turns tokens back into text, and you read: <i>Yes: all 33 tests pass (flutter test).</i>',
		],
		stepsOff: [
			'You type a question: <b>“Do the tests pass?”</b>',
			'A plain chat has no project files: the context is a short system prompt and your message.',
			'The <b>tokenizer</b> turns the context into token IDs.',
			'The <b>transformer</b> computes a probability for every possible next token.',
			'<b>Sampling</b> picks one token, here <code>Yes</code>.',
			'Token by token, it writes the most likely continuation: <i>Yes, all tests pass.</i>',
			'<b>Nothing ran.</b> There are no tools to call. The answer is just the most plausible sentence, and it reads exactly as confidently as a checked one.',
		],
	},
	pl: {
		kicker: 'Interaktywny diagram',
		title: 'Jedno pytanie, od początku do końca',
		play: '▶ Odtwórz', pause: '❚❚ Pauza', prev: '◀', next: '▶', reset: 'Od nowa',
		harnessOn: 'Harness z narzędziami', harnessOff: 'Sam model (czat)',
		step: 'Krok {n} z {total}',
		ctx: 'Context window', out: 'Co widzisz',
		nodes: { you: 'Ty', harness: 'Harness', tok: 'Tokenizer', model: 'Transformer', sample: 'Losowanie', tools: 'Narzędzia', detok: 'Detokenizer' },
		subs: { harness: 'buduje kontekst, uruchamia narzędzia', tok: 'tekst → ID tokenów', model: 'miliardy parametrów', sample: 'wybór następnego tokenu', tools: 'czytaj · uruchom · szukaj', detok: 'tokeny → tekst' },
		blocks: { sys: 'system prompt', agents: 'AGENTS.md', user: 'Czy testy przechodzą?', call: 'run_command("flutter test")', result: '00:05 +33: All tests passed!', answer: 'Tak: wszystkie 33 testy przechodzą (flutter test).', fake: 'Tak, wszystkie testy przechodzą.' },
		steps: [
			'Wpisujesz pytanie: <b>„Czy testy przechodzą?”</b>',
			'<b>Harness</b> buduje kontekst: swój system prompt, twój <code>AGENTS.md</code>, a potem twoją wiadomość. Model zobaczy tylko to.',
			'<b>Tokenizer</b> zamienia cały kontekst na ID tokenów: w prawdziwym projekcie to tysiące.',
			'<b>Transformer</b> czyta wszystkie tokeny naraz, przez dziesiątki warstw, i liczy jedno: prawdopodobieństwo każdego możliwego następnego tokenu.',
			'<b>Losowanie</b> wybiera jeden token, tu <code>Uruchomię</code>. To jedyny wynik jednego przebiegu.',
			'Token trafia na koniec kontekstu i wszystko rusza od nowa po kolejny. <b>Token po tokenie</b> model pisze: <i>Uruchomię testy.</i>',
			'Teraz model pisze specjalne <b>wywołanie narzędzia</b>: <code>run_command("flutter test")</code>. Model niczego nie uruchamia. Pisze tylko tekst, który o to prosi.',
			'<b>Harness</b> rozpoznaje wywołanie i uruchamia polecenie na twoim komputerze, z twoimi uprawnieniami.',
			'Wynik narzędzia wraca <b>do kontekstu</b>: <code>00:05 +33: All tests passed!</code> Prawdziwy dowód, a nie zgadywanie.',
			'Model czyta kontekst jeszcze raz, już z wynikiem, i pisze odpowiedź token po tokenie.',
			'<b>Detokenizer</b> zamienia tokeny z powrotem w tekst, a ty czytasz: <i>Tak: wszystkie 33 testy przechodzą (flutter test).</i>',
		],
		stepsOff: [
			'Wpisujesz pytanie: <b>„Czy testy przechodzą?”</b>',
			'Zwykły czat nie ma plików projektu: kontekst to krótki system prompt i twoja wiadomość.',
			'<b>Tokenizer</b> zamienia kontekst na ID tokenów.',
			'<b>Transformer</b> liczy prawdopodobieństwo każdego możliwego następnego tokenu.',
			'<b>Losowanie</b> wybiera jeden token, tu <code>Tak</code>.',
			'Token po tokenie pisze najbardziej prawdopodobny ciąg dalszy: <i>Tak, wszystkie testy przechodzą.</i>',
			'<b>Nic nie zostało uruchomione.</b> Nie ma narzędzi do wywołania. Odpowiedź to po prostu najbardziej wiarygodnie brzmiące zdanie – i brzmi dokładnie tak samo pewnie jak sprawdzona.',
		],
	},
}[lang];

// Step scripts: which node is active, which edge the packet travels, which
// context blocks exist, and what the "you see" line shows.
const on = [
	{ node: 'you', edge: null, ctx: [], out: '' },
	{ node: 'harness', edge: 'you>harness', ctx: ['sys', 'agents', 'user'], out: '' },
	{ node: 'tok', edge: 'harness>tok', ctx: ['sys', 'agents', 'user'], out: '' },
	{ node: 'model', edge: 'tok>model', ctx: ['sys', 'agents', 'user'], out: '' },
	{ node: 'sample', edge: 'model>sample', ctx: ['sys', 'agents', 'user', 'gen1'], out: '' },
	{ node: 'model', edge: 'sample>model', ctx: ['sys', 'agents', 'user', 'gen'], out: '' },
	{ node: 'harness', edge: 'sample>harness', ctx: ['sys', 'agents', 'user', 'gen', 'call'], out: '' },
	{ node: 'tools', edge: 'harness>tools', ctx: ['sys', 'agents', 'user', 'gen', 'call'], out: '' },
	{ node: 'harness', edge: 'tools>harness', ctx: ['sys', 'agents', 'user', 'gen', 'call', 'result'], out: '' },
	{ node: 'model', edge: 'harness>tok', ctx: ['sys', 'agents', 'user', 'gen', 'call', 'result', 'answer'], out: '' },
	{ node: 'you', edge: 'detok>you', ctx: ['sys', 'agents', 'user', 'gen', 'call', 'result', 'answer'], out: 'answer' },
];
const off = [
	{ node: 'you', edge: null, ctx: [], out: '' },
	{ node: 'harness', edge: 'you>harness', ctx: ['sys', 'user'], out: '' },
	{ node: 'tok', edge: 'harness>tok', ctx: ['sys', 'user'], out: '' },
	{ node: 'model', edge: 'tok>model', ctx: ['sys', 'user'], out: '' },
	{ node: 'sample', edge: 'model>sample', ctx: ['sys', 'user', 'fake1'], out: '' },
	{ node: 'model', edge: 'sample>model', ctx: ['sys', 'user', 'fake'], out: '' },
	{ node: 'you', edge: 'detok>you', ctx: ['sys', 'user', 'fake'], out: 'fake' },
];
const data = { on, off, steps: copy.steps, stepsOff: copy.stepsOff, blocks: copy.blocks, step: copy.step, play: copy.play, pause: copy.pause, gen1: lang === 'pl' ? 'Uruchomię' : 'I’ll', gen: lang === 'pl' ? 'Uruchomię testy.' : 'I’ll run the tests.', fake1: lang === 'pl' ? 'Tak' : 'Yes' };
---

<div class="biz-widget llmflow not-content" data-flow={JSON.stringify(data)}>
	<div class="biz-head">
		<div>
			<p class="biz-kicker">{copy.kicker}</p>
			<p class="biz-title">{copy.title}</p>
		</div>
		<div class="llmflow__mode" role="group">
			<button type="button" class="llmflow__mode-btn is-on" data-mode="on">{copy.harnessOn}</button>
			<button type="button" class="llmflow__mode-btn" data-mode="off">{copy.harnessOff}</button>
		</div>
	</div>

	<div class="llmflow__scroll"><svg class="llmflow__svg" viewBox="0 0 960 430" role="img" aria-label={copy.title}>
		<defs>
			<marker id="lf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" /></marker>
			<linearGradient id="lf-model" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#2563EB" /><stop offset="1" stop-color="#7C3AED" /></linearGradient>
		</defs>
		<rect class="llmflow__harness" x="150" y="20" width="790" height="300" rx="22" />
		<text class="llmflow__harness-label" x="172" y="44">{copy.nodes.harness} · {copy.subs.harness}</text>

		<g class="llmflow__edges">
			<path data-edge="you>harness" d="M110 175 L 200 175" />
			<path data-edge="harness>tok" d="M318 175 L 370 175" />
			<path data-edge="tok>model" d="M488 175 L 540 175" />
			<path data-edge="model>sample" d="M700 175 L 752 175" />
			<path data-edge="sample>model" class="is-loop" d="M811 145 C 811 80, 620 80, 620 125" />
			<path data-edge="sample>harness" class="is-tool" d="M811 205 C 811 290, 259 290, 259 205" />
			<path data-edge="harness>tools" class="is-tool" d="M259 205 L 259 360" />
			<path data-edge="tools>harness" class="is-tool" d="M289 360 L 289 205" />
			<path data-edge="detok>you" d="M811 205 C 811 410, 60 410, 60 215" />
		</g>

		<g class="llmflow__node" data-node="you"><circle cx="60" cy="175" r="40" /><text x="60" y="180">{copy.nodes.you}</text></g>
		<g class="llmflow__node" data-node="harness"><rect x="200" y="135" width="118" height="80" rx="14" /><text x="259" y="172">{copy.nodes.harness}</text><text class="sub" x="259" y="192">context</text></g>
		<g class="llmflow__node" data-node="tok"><rect x="370" y="135" width="118" height="80" rx="14" /><text x="429" y="172">{copy.nodes.tok}</text><text class="sub" x="429" y="192">{copy.subs.tok}</text></g>
		<g class="llmflow__node is-model" data-node="model">
			<rect x="540" y="125" width="160" height="100" rx="16" />
			<g class="llmflow__layers">
				<rect x="556" y="140" width="128" height="9" rx="4" /><rect x="556" y="154" width="128" height="9" rx="4" /><rect x="556" y="168" width="128" height="9" rx="4" /><rect x="556" y="182" width="128" height="9" rx="4" />
			</g>
			<text x="620" y="212">{copy.nodes.model}</text>
		</g>
		<g class="llmflow__node" data-node="sample">
			<rect x="752" y="135" width="118" height="80" rx="14" />
			<g class="llmflow__bars"><rect x="770" y="160" width="10" height="24" /><rect x="784" y="168" width="10" height="16" /><rect x="798" y="174" width="10" height="10" /><rect x="812" y="178" width="10" height="6" /><rect x="826" y="180" width="10" height="4" /></g>
			<text x="811" y="203">{copy.nodes.sample}</text>
		</g>
		<g class="llmflow__node is-tools" data-node="tools"><rect x="200" y="350" width="118" height="62" rx="14" /><text x="259" y="378">{copy.nodes.tools}</text><text class="sub" x="259" y="397">{copy.subs.tools}</text></g>
		<text class="llmflow__edge-label" x="640" y="78">+1 token</text>
		<text class="llmflow__edge-label is-tool" x="520" y="282">tool call</text>
		<circle class="llmflow__packet" r="8" cx="-20" cy="-20" />
	</svg></div>

	<div class="llmflow__panels">
		<div class="llmflow__ctx"><p class="llmflow__label">{copy.ctx}</p><div class="llmflow__blocks"></div></div>
		<div class="llmflow__out"><p class="llmflow__label">{copy.out}</p><p class="llmflow__answer"></p></div>
	</div>

	<div class="llmflow__bar">
		<button type="button" class="sdlc-btn" data-act="prev" aria-label="prev">{copy.prev}</button>
		<button type="button" class="sdlc-btn sdlc-btn--primary" data-act="play">{copy.play}</button>
		<button type="button" class="sdlc-btn" data-act="next" aria-label="next">{copy.next}</button>
		<button type="button" class="sdlc-btn" data-act="reset">{copy.reset}</button>
		<span class="llmflow__status" aria-live="polite"></span>
	</div>
	<p class="llmflow__narr" aria-live="polite"></p>
</div>

<script>
	const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.llmflow').forEach((box) => {
		const D = JSON.parse(box.dataset.flow || '{}');
		const svg = box.querySelector('svg')!;
		const packet = box.querySelector<SVGCircleElement>('.llmflow__packet')!;
		const blocksEl = box.querySelector<HTMLElement>('.llmflow__blocks')!;
		const answer = box.querySelector<HTMLElement>('.llmflow__answer')!;
		const narr = box.querySelector<HTMLElement>('.llmflow__narr')!;
		const status = box.querySelector<HTMLElement>('.llmflow__status')!;
		const playBtn = box.querySelector<HTMLButtonElement>('[data-act="play"]')!;
		let mode: 'on' | 'off' = 'on';
		let i = 0;
		let timer: number | undefined;
		let raf = 0;

		const blockText: Record<string, [string, string]> = {
			sys: [D.blocks.sys, 'is-sys'], agents: [D.blocks.agents, 'is-agents'], user: [D.blocks.user, 'is-user'],
			gen1: [D.gen1, 'is-gen'], gen: [D.gen, 'is-gen'], call: [D.blocks.call, 'is-call'], result: [D.blocks.result, 'is-result'],
			answer: [D.blocks.answer, 'is-gen'], fake1: [D.fake1, 'is-gen'], fake: [D.blocks.fake, 'is-fake'],
		};

		const move = (edge: string | null) => {
			cancelAnimationFrame(raf);
			svg.querySelectorAll('.llmflow__edges path').forEach((p) => p.classList.remove('is-active'));
			if (!edge) { packet.setAttribute('cx', '-20'); return; }
			const path = svg.querySelector<SVGPathElement>(`[data-edge="${edge}"]`);
			if (!path) return;
			path.classList.add('is-active');
			const len = path.getTotalLength();
			const dur = reduce ? 1 : Math.min(1400, 400 + len * 1.4);
			const t0 = performance.now();
			const frame = (t: number) => {
				const f = Math.min(1, (t - t0) / dur);
				const e = f < 0.5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
				const pt = path.getPointAtLength(e * len);
				packet.setAttribute('cx', String(pt.x));
				packet.setAttribute('cy', String(pt.y));
				if (f < 1) raf = requestAnimationFrame(frame);
			};
			raf = requestAnimationFrame(frame);
		};

		const render = () => {
			const steps = D[mode];
			const texts = mode === 'on' ? D.steps : D.stepsOff;
			const s = steps[i];
			svg.querySelectorAll('.llmflow__node').forEach((n) => n.classList.toggle('is-active', (n as HTMLElement).dataset.node === s.node));
			svg.classList.toggle('is-off', mode === 'off');
			const sc = box.querySelector<HTMLElement>('.llmflow__scroll')!;
			const act = svg.querySelector(`[data-node="${s.node}"]`);
			if (act && sc.scrollWidth > sc.clientWidth) {
				const r = act.getBoundingClientRect(), c = sc.getBoundingClientRect();
				sc.scrollTo({ left: sc.scrollLeft + r.left - c.left - (c.width - r.width) / 2, behavior: reduce ? 'auto' : 'smooth' });
			}
			move(s.edge);
			blocksEl.textContent = '';
			s.ctx.forEach((k: string, j: number) => {
				const [txt, cls] = blockText[k];
				const b = document.createElement('span');
				b.className = `llmflow__block ${cls}` + (j === s.ctx.length - 1 && i > 0 ? ' is-new' : '');
				b.textContent = txt;
				blocksEl.appendChild(b);
			});
			answer.textContent = s.out ? blockText[s.out][0] : '…';
			answer.className = 'llmflow__answer' + (s.out === 'fake' ? ' is-fake' : s.out ? ' is-ok' : '');
			narr.innerHTML = texts[i];
			narr.classList.toggle('is-warn', mode === 'off' && i === steps.length - 1);
			status.textContent = String(D.step).replace('{n}', String(i + 1)).replace('{total}', String(steps.length));
		};
		const go = (k: number) => { const n = D[mode].length; i = Math.max(0, Math.min(n - 1, k)); render(); };
		const stop = () => { clearInterval(timer); timer = undefined; playBtn.textContent = D.play; };
		playBtn.addEventListener('click', () => {
			if (timer) return stop();
			if (i >= D[mode].length - 1) i = -1;
			playBtn.textContent = D.pause;
			go(i + 1);
			timer = window.setInterval(() => { if (i >= D[mode].length - 1) return stop(); go(i + 1); }, 2600);
		});
		box.querySelector('[data-act="next"]')!.addEventListener('click', () => { stop(); go(i + 1); });
		box.querySelector('[data-act="prev"]')!.addEventListener('click', () => { stop(); go(i - 1); });
		box.querySelector('[data-act="reset"]')!.addEventListener('click', () => { stop(); go(0); });
		box.querySelectorAll<HTMLButtonElement>('.llmflow__mode-btn').forEach((b) =>
			b.addEventListener('click', () => {
				stop();
				mode = b.dataset.mode as 'on' | 'off';
				box.querySelectorAll('.llmflow__mode-btn').forEach((x) => x.classList.toggle('is-on', x === b));
				go(0);
			}),
		);
		render();
	});
</script>
