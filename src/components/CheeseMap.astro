---
/**
 * §6 Swiss cheese: a slice of capabilities. Solid cheese = what a model does
 * well; holes = surprising failures. Switch on a code tool, web search or
 * your project's context and checks to patch the holes they cover.
 * English and Polish.
 */
import { langOf } from '../i18n/ui';
const lang = langOf(Astro);

type Spot = { key: string; x: number; y: number; r?: number; text: string; why: string; fix?: string[] };
const copy = {
	en: {
		kicker: 'The Swiss cheese of capabilities',
		hint: 'Click a hole or a solid spot. Then switch on what you give the model, and watch which holes close.',
		holes: 'holes left',
		patches: [
			{ key: 'code', label: '🧮 Code tool', tip: 'the model writes and runs code' },
			{ key: 'search', label: '🔎 Web search', tip: 'the model looks things up, with sources' },
			{ key: 'ctx', label: '🗂️ Project context and checks', tip: 'your files in the context, tests, review' },
		],
		spots: [
			{ key: 'explain', x: 13, y: 20, text: 'Explain a concept', why: 'Strong: explanations of well-known ideas are everywhere in the training data.' },
			{ key: 'widget', x: 62, y: 17, text: 'Write a Flutter widget', why: 'Strong: lots of similar code in the training data. Still needs the gate and tests.' },
			{ key: 'translate', x: 38, y: 46, text: 'Translate PL ↔ EN', why: 'Strong: one of the things models do best.' },
			{ key: 'summary', x: 37, y: 76, text: 'Summarise meeting notes', why: 'Strong, but check it: summaries can drop or add things.' },
			{ key: 'email', x: 86, y: 47, text: 'Draft an email to the client', why: 'Strong: a first draft in seconds. You own what is sent.' },
			{ key: 'r', x: 37, y: 23, r: 7, text: 'Count the r’s in “strawberry”', why: 'A hole: the model sees tokens (straw + berry), not letters.', fix: ['code'] },
			{ key: 'nine', x: 14, y: 49, r: 6, text: '9.11 or 9.9: which is bigger?', why: 'A hole: some models have said 9.11, perhaps because 9.11 comes after 9.9 in verses and version numbers.', fix: ['code'] },
			{ key: 'mult', x: 86, y: 24, r: 6, text: '4,817 × 3,912 in one go', why: 'A hole: an answer squeezed into a few tokens gets little computation. Code gets it right.', fix: ['code'] },
			{ key: 'cite', x: 62, y: 51, r: 8, text: 'Give a reference with a DOI', why: 'A hole: a fluent, invented citation. Search finds real ones; you still open them.', fix: ['search'] },
			{ key: 'news', x: 62, y: 80, r: 6, text: 'What changed in the stores this year?', why: 'A hole: the weights end at the training cut-off.', fix: ['search'] },
			{ key: 'adr', x: 13, y: 78, r: 7, text: 'Why your project decided X', why: 'A hole: the model never saw your decision record, so it invents a reason.', fix: ['ctx'] },
			{ key: 'tests', x: 86, y: 76, r: 7, text: '“All tests pass”', why: 'A hole: without running anything, “all tests pass” is just a likely sentence.', fix: ['code', 'ctx'] },
		] as Spot[],
	},
	pl: {
		kicker: 'Ser szwajcarski możliwości',
		hint: 'Kliknij dziurę albo pełne miejsce. Potem włącz to, co dajesz modelowi, i zobacz, które dziury się zamykają.',
		holes: 'zostało dziur',
		patches: [
			{ key: 'code', label: '🧮 Narzędzie do kodu', tip: 'model pisze i uruchamia kod' },
			{ key: 'search', label: '🔎 Wyszukiwanie w sieci', tip: 'model sprawdza, ze źródłami' },
			{ key: 'ctx', label: '🗂️ Kontekst projektu i checki', tip: 'twoje pliki w kontekście, testy, review' },
		],
		spots: [
			{ key: 'explain', x: 13, y: 20, text: 'Wyjaśnij pojęcie', why: 'Mocna strona: wyjaśnień znanych pojęć jest w danych treningowych pełno.' },
			{ key: 'widget', x: 62, y: 17, text: 'Napisz widget we Flutterze', why: 'Mocna strona: dużo podobnego kodu w danych. Nadal potrzebny gate i testy.' },
			{ key: 'translate', x: 38, y: 46, text: 'Przetłumacz PL ↔ EN', why: 'Mocna strona: jedna z rzeczy, które modele robią najlepiej.' },
			{ key: 'summary', x: 37, y: 76, text: 'Streść notatki ze spotkania', why: 'Mocna strona, ale sprawdź: streszczenia potrafią coś pominąć albo dodać.' },
			{ key: 'email', x: 86, y: 47, text: 'Napisz mail do klienta', why: 'Mocna strona: pierwsza wersja w kilka sekund. Za to, co wyślesz, odpowiadasz ty.' },
			{ key: 'r', x: 37, y: 23, r: 7, text: 'Policz „r” w „strawberry”', why: 'Dziura: model widzi tokeny (straw + berry), a nie litery.', fix: ['code'] },
			{ key: 'nine', x: 14, y: 49, r: 6, text: '9.11 czy 9.9: co większe?', why: 'Dziura: niektóre modele odpowiadały 9.11, może dlatego, że w wersetach i numerach wersji 9.11 jest po 9.9.', fix: ['code'] },
			{ key: 'mult', x: 86, y: 24, r: 6, text: '4817 × 3912 od razu', why: 'Dziura: odpowiedź wciśnięta w kilka tokenów dostaje mało obliczeń. Kod liczy dobrze.', fix: ['code'] },
			{ key: 'cite', x: 62, y: 51, r: 8, text: 'Podaj publikację z DOI', why: 'Dziura: płynny, zmyślony cytat. Wyszukiwanie znajdzie prawdziwe; i tak je otwórz.', fix: ['search'] },
			{ key: 'news', x: 62, y: 80, r: 6, text: 'Co zmieniło się w sklepach w tym roku?', why: 'Dziura: wagi kończą się w dniu odcięcia treningu.', fix: ['search'] },
			{ key: 'adr', x: 13, y: 78, r: 7, text: 'Dlaczego twój projekt zdecydował X', why: 'Dziura: model nigdy nie widział waszego zapisu decyzji, więc wymyśla powód.', fix: ['ctx'] },
			{ key: 'tests', x: 86, y: 76, r: 7, text: '„Wszystkie testy przechodzą”', why: 'Dziura: bez uruchomienia czegokolwiek to tylko prawdopodobne zdanie.', fix: ['code', 'ctx'] },
		] as Spot[],
	},
}[lang];
---

<div class="biz-widget cheese not-content">
	<div class="biz-head">
		<p class="biz-kicker">{copy.kicker}</p>
		<span class="cheese__count"><b>–</b> {copy.holes}</span>
	</div>
	<p class="biz-intro">{copy.hint}</p>
	<div class="cheese__patches" role="group">
		{copy.patches.map((p) => <button type="button" class="cheese__patch" data-key={p.key} aria-pressed="false" title={p.tip}>{p.label}</button>)}
	</div>
	<div class="cheese__slice">
		<svg class="cheese__shape" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
			<defs>
				<linearGradient id="cheese-g" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#FDE68A" /><stop offset="1" stop-color="#F59E0B" /></linearGradient>
			</defs>
			<path d="M2 58 L2 14 Q2 4 12 3 L98 1 L98 58 Z" fill="url(#cheese-g)" />
		</svg>
		{
			copy.spots.map((s) => (
				<button
					type="button"
					class={s.fix ? 'cheese__spot is-hole' : 'cheese__spot is-solid'}
					data-key={s.key}
					data-fix={(s.fix ?? []).join(' ')}
					data-why={s.why}
					style={`left:${s.x}%;top:${s.y}%;--r:${s.r ?? 0}`}
				>
					<span class="cheese__mark" aria-hidden="true"></span>
					<span class="cheese__text">{s.text}</span>
				</button>
			))
		}
	</div>
	<p class="cheese__why" aria-live="polite"></p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.cheese').forEach((box) => {
		const spots = Array.from(box.querySelectorAll<HTMLButtonElement>('.cheese__spot'));
		const patches = Array.from(box.querySelectorAll<HTMLButtonElement>('.cheese__patch'));
		const why = box.querySelector<HTMLElement>('.cheese__why')!;
		const count = box.querySelector<HTMLElement>('.cheese__count b')!;
		const render = () => {
			const on = patches.filter((p) => p.getAttribute('aria-pressed') === 'true').map((p) => p.dataset.key!);
			let left = 0;
			spots.forEach((s) => {
				if (!s.classList.contains('is-hole')) return;
				const fix = (s.dataset.fix || '').split(' ').filter(Boolean);
				const by = fix.find((f) => on.includes(f));
				s.classList.toggle('is-patched', !!by);
				s.dataset.by = by || '';
				if (!by) left++;
			});
			count.textContent = String(left);
		};
		spots.forEach((s) =>
			s.addEventListener('click', () => {
				spots.forEach((x) => x.classList.toggle('is-picked', x === s));
				why.textContent = s.dataset.why || '';
				why.className = 'cheese__why ' + (s.classList.contains('is-hole') ? (s.classList.contains('is-patched') ? 'is-patched' : 'is-hole') : 'is-solid');
			}),
		);
		patches.forEach((p) =>
			p.addEventListener('click', () => {
				p.setAttribute('aria-pressed', p.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
				render();
			}),
		);
		render();
	});
</script>
