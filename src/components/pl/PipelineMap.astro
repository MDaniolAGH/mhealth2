---
/**
 * The interactive pipeline map (Polish): ten stages in three lanes (you, agent, tools),
 * the project knowledge on the left and the auditability rail. Behaviour is in
 * src/scripts/sdlc.js. Without JavaScript, every stage is a plain link.
 */
import { link } from '../../lib/url';

const s = {
	idea: link('ai-sdlc/idea-to-plan/#stage-idea', 'pl'),
	analysis: link('ai-sdlc/idea-to-plan/#stage-analysis', 'pl'),
	requirements: link('ai-sdlc/idea-to-plan/#stage-requirements', 'pl'),
	plan: link('ai-sdlc/idea-to-plan/#stage-plan', 'pl'),
	implementation: link('ai-sdlc/code-and-gate/#stage-implementation', 'pl'),
	gate: link('ai-sdlc/code-and-gate/#stage-gate', 'pl'),
	tests: link('ai-sdlc/tests-to-merge/#stage-tests', 'pl'),
	docs: link('ai-sdlc/tests-to-merge/#stage-docs', 'pl'),
	pr: link('ai-sdlc/tests-to-merge/#stage-pr', 'pl'),
	review: link('ai-sdlc/tests-to-merge/#stage-review', 'pl'),
	knowledge: link('ai-sdlc/knowledge/', 'pl'),
	agentsMd: link('ai-sdlc/agents-md/', 'pl'),
};

// Feedback loops and knowledge flows, drawn by src/scripts/sdlc.js.
const flows = {
	loops: [
		{ from: 'gate', to: 'implementation', label: 'błąd → poprawka', kind: 'fail', layer: 'base', lane: 0.28, dy: 10 },
		{ from: 'tests', to: 'implementation', label: 'testy padają', kind: 'loop', layer: 'loops', lane: 0.58, dy: 1, labelDy: 26, wideOnly: true },
		{ from: 'review', to: 'implementation', label: 'prośba o zmiany', kind: 'loop', layer: 'loops', lane: 0.88, dy: -8, labelAt: 'from' },
		{ from: 'plan', to: 'requirements', label: 'niejasne → przepisz', kind: 'loop', layer: 'loops', lane: 'near' },
	],
	kb: [
		{ to: 'plan', layer: 'base' },
		{ from: 'docs', layer: 'base' },
		{ to: 'requirements', layer: 'knowledge' },
		{ to: 'implementation', layer: 'knowledge' },
		{ from: 'review', layer: 'knowledge', label: 'po merge' },
		{ to: 'idea', layer: 'knowledge', label: 'kolejna iteracja' },
	],
};

const i18n = JSON.stringify({
	play: '▶ Przejdź krok po kroku',
	pause: '❚❚ Pauza',
	step: 'Krok {n} z {total}',
	readSection: 'Przeczytaj cały rozdział →',
	readKb: 'Przeczytaj, czym jest wiedza o projekcie →',
	traced: 'Podświetlone: każdy etap, przez który da się prześledzić ten zapis wstecz, aż do pomysłu.',
});
---

<div class="sdlc not-content" data-i18n={i18n}>
	<div class="sdlc-toolbar">
		<div class="sdlc-toolbar__group" role="group" aria-label="Przejdź pipeline krok po kroku">
			<button type="button" class="sdlc-btn" data-action="prev" aria-label="Poprzedni krok">◀</button>
			<button type="button" class="sdlc-btn sdlc-btn--primary" data-action="play">▶ Przejdź krok po kroku</button>
			<button type="button" class="sdlc-btn" data-action="next" aria-label="Następny krok">▶</button>
			<span class="sdlc-toolbar__status" aria-live="polite"></span>
		</div>
		<div class="sdlc-toolbar__group" role="group" aria-label="Warstwy">
			<span class="sdlc-legend__hint">Pokaż:</span>
			<button type="button" class="sdlc-chip is-loop" data-layer="loops" aria-pressed="false">Pętle zwrotne</button>
			<button type="button" class="sdlc-chip is-knowledge" data-layer="knowledge" aria-pressed="false">Przepływy wiedzy</button>
			<button type="button" class="sdlc-chip is-audit" data-layer="audit" aria-pressed="false">Ślad audytowy</button>
		</div>
	</div>

	<div class="sdlc-legend">
		<span class="sdlc-legend__hint">Kto:</span>
		<button type="button" class="sdlc-chip is-you" data-actor="you" aria-pressed="false">Ty i twoja para</button>
		<button type="button" class="sdlc-chip is-agent" data-actor="agent" aria-pressed="false">Agent kodujący</button>
		<button type="button" class="sdlc-chip is-tool" data-actor="tool" aria-pressed="false">Narzędzia deterministyczne</button>
	</div>

	<div class="sdlc-map" role="group" aria-label="Pipeline AI SDLC: dziesięć etapów od pomysłu do merge'a, z wiedzą o projekcie po lewej" data-flows={JSON.stringify(flows)}>
		<div class="sdlc-lane sdlc-lane--you is-you" aria-hidden="true"></div>
		<div class="sdlc-lane sdlc-lane--agent is-agent" aria-hidden="true"></div>
		<div class="sdlc-lane sdlc-lane--tool is-tool" aria-hidden="true"></div>
		<div class="sdlc-lane-title is-knowledge" style="grid-column:2">Wiedza</div>
		<div class="sdlc-lane-title is-you" style="grid-column:4">Ty</div>
		<div class="sdlc-lane-title is-agent" style="grid-column:5">Agent</div>
		<div class="sdlc-lane-title is-tool" style="grid-column:6">Narzędzia</div>
		<div class="sdlc-rail" aria-hidden="true"><span>Audytowalność</span><i class="sdlc-rail__fill"></i></div>

		<div class="sdlc-kb is-knowledge">
			<a class="sdlc-kb__title" href={s.knowledge}>Wiedza o pro&shy;jekcie</a>
			<a class="sdlc-kb__doc" href={s.knowledge} data-doc="architecture" data-feeds="analysis requirements plan implementation review">Archi&shy;tektura</a>
			<a class="sdlc-kb__doc" href={s.knowledge} data-doc="decisions" data-feeds="plan review">Decy&shy;zje</a>
			<a class="sdlc-kb__doc" href={s.knowledge} data-doc="notes" data-feeds="plan implementation">Notatki i log</a>
			<a class="sdlc-kb__doc" href={s.knowledge} data-doc="product" data-feeds="analysis requirements plan review">Produkt i klient</a>
			<a class="sdlc-kb__doc" href={s.knowledge} data-doc="api" data-feeds="requirements plan implementation">README i API</a>
			<a class="sdlc-kb__doc" href={s.agentsMd} data-doc="agents" data-feeds="requirements plan implementation gate tests review">AGENTS<wbr />.md</a>
		</div>

		<a class="sdlc-stage is-you" href={s.idea} data-stage="idea" data-order="1" data-actors="you" style="--row:2;--col:4"><span class="sdlc-stage__n">1</span><span class="sdlc-stage__t">Pomysł</span><span class="sdlc-stage__s">szkic, jedno zdanie</span><span class="sdlc-stage__rec">issue #7</span></a>
		<a class="sdlc-stage is-you" href={s.analysis} data-stage="analysis" data-order="2" data-actors="you" style="--row:3;--col:4"><span class="sdlc-stage__n">2</span><span class="sdlc-stage__t">Analiza</span><span class="sdlc-stage__s">zdefiniuj cel</span><span class="sdlc-stage__rec">GOAL-1</span></a>
		<a class="sdlc-stage is-you-agent" href={s.requirements} data-stage="requirements" data-order="3" data-actors="you agent" style="--row:4;--col:4 / 6"><span class="sdlc-stage__n">3</span><span class="sdlc-stage__t">Wymagania tech&shy;niczne</span><span class="sdlc-stage__s">kryteria do sprawdzenia</span><span class="sdlc-stage__rec">AC-1…AC-6</span></a>
		<a class="sdlc-stage is-you-agent is-kb-reader" href={s.plan} data-stage="plan" data-order="4" data-actors="you agent" style="--row:5;--col:4 / 6"><span class="sdlc-stage__n">4</span><span class="sdlc-stage__t">Plan</span><span class="sdlc-stage__s">czyta wiedzę o projekcie · ty zatwierdzasz</span><span class="sdlc-stage__rec">plan + odpowiedzi</span></a>
		<a class="sdlc-stage is-agent" href={s.implementation} data-stage="implementation" data-order="5" data-actors="agent" style="--row:6;--col:5"><span class="sdlc-stage__n">5</span><span class="sdlc-stage__t">Imple&shy;mentacja</span><span class="sdlc-stage__s">branch, małe commity</span><span class="sdlc-stage__rec">Refs: GOAL-1</span></a>
		<a class="sdlc-stage is-tool" href={s.gate} data-stage="gate" data-order="6" data-actors="tool" style="--row:7;--col:6"><span class="sdlc-stage__n">6</span><span class="sdlc-stage__t">Quality gate</span><span class="sdlc-stage__s">ten sam kod, ten sam werdykt</span><span class="sdlc-stage__rec">log CI</span></a>
		<a class="sdlc-stage is-agent-tool" href={s.tests} data-stage="tests" data-order="7" data-actors="agent tool you" style="--row:8;--col:5 / 7"><span class="sdlc-stage__n">7</span><span class="sdlc-stage__t">Testy</span><span class="sdlc-stage__s">unit, widget, end-to-end, na żywo</span><span class="sdlc-stage__rec">raport z testów</span></a>
		<a class="sdlc-stage is-you-agent" href={s.docs} data-stage="docs" data-order="8" data-actors="you agent" style="--row:9;--col:4 / 6"><span class="sdlc-stage__n">8</span><span class="sdlc-stage__t">Dokumen&shy;tacja</span><span class="sdlc-stage__s">aktualizuj to, co czyta kolejny plan</span><span class="sdlc-stage__rec">ADR-0003</span></a>
		<a class="sdlc-stage is-you-agent" href={s.pr} data-stage="pr" data-order="9" data-actors="you agent" style="--row:10;--col:4 / 6"><span class="sdlc-stage__n">9</span><span class="sdlc-stage__t">Pull request</span><span class="sdlc-stage__s">agent szkicuje, ty za niego odpowiadasz</span><span class="sdlc-stage__rec">PR #12</span></a>
		<a class="sdlc-stage is-you" href={s.review} data-stage="review" data-order="10" data-actors="you" style="--row:11;--col:4"><span class="sdlc-stage__n">10</span><span class="sdlc-stage__t">Review i merge</span><span class="sdlc-stage__s">decyduje człowiek</span><span class="sdlc-stage__rec">zatwierdzenie</span></a>
	</div>

	<div class="sdlc-panel" aria-live="polite"><p class="sdlc-panel__empty">Kliknij etap lub dokument albo naciśnij <b>Przejdź krok po kroku</b>.</p></div>

	<div class="sdlc-details">
		<div data-detail="idea"><h4>1. Pomysł</h4><dl><dt>Kto</dt><dd>Ty albo klient, który chce tej funkcji</dd><dt>Wejście</dt><dd>Potrzeba użytkownika</dd><dt>Wyjście</dt><dd>Szkic i jedno zdanie, zapisane jako issue</dd><dt>Sprawdź</dt><dd>Umiesz powiedzieć, dla kogo to jest?</dd></dl></div>
		<div data-detail="analysis"><h4>2. Analiza</h4><dl><dt>Kto</dt><dd>Ty: spojrzenie biznesowe i techniczne naraz</dd><dt>Wejście</dt><dd>Pomysł; karta produktu i architektura, żeby zobaczyć, czego to dotyka</dd><dt>Wyjście</dt><dd>Cel z ID: co robi ekran, jaką ma wartość, z czym się integruje, ograniczenia, co jest poza zakresem</dd><dt>Sprawdź</dt><dd>Czy dwie pary zbudowałyby z tego to samo?</dd></dl></div>
		<div data-detail="requirements"><h4>3. Wymagania techniczne</h4><dl><dt>Kto</dt><dd>Ty decydujesz; agent może przygotować szkic i zadawać pytania</dd><dt>Wejście</dt><dd>Cel, dziennik klienta, dokumentacja architektury i API, <code>AGENTS.md</code></dd><dt>Wyjście</dt><dd><code>docs/spec-about.md</code>: ponumerowane, obserwowalne kryteria AC-1…AC-6</dd><dt>Sprawdź</dt><dd>Każde kryterium da się potwierdzić albo obalić testem lub uruchomieniem</dd></dl></div>
		<div data-detail="plan"><h4>4. Plan</h4><dl><dt>Kto</dt><dd>Agent proponuje; ty zatwierdzasz, poprawiasz albo prosisz o inne podejście</dd><dt>Wejście</dt><dd>Kryteria i <b>wiedza o projekcie</b>: architektura, zapisy decyzji, notatki, karta produktu, dokumentacja API, <code>AGENTS.md</code></dd><dt>Wyjście</dt><dd>Zatwierdzony plan: pliki, podejście, dokumenty, na których się oparł, znalezione sprzeczności, odpowiedzi na pytania</dd><dt>Sprawdź</dt><dd>Każde kryterium ma swój krok; plan pasuje do architektury i zapisanych decyzji</dd></dl></div>
		<div data-detail="implementation"><h4>5. Implementacja</h4><dl><dt>Kto</dt><dd>Agent w swoim harnessie</dd><dt>Wejście</dt><dd>Zatwierdzony plan, notatki, <code>AGENTS.md</code></dd><dt>Wyjście</dt><dd>Małe zmiany na branchu, z opisami commitów, które wyjaśniają dlaczego</dd><dt>Sprawdź</dt><dd>Diff zgadza się z planem; żadnych niezwiązanych zmian</dd></dl></div>
		<div data-detail="gate"><h4>6. Quality gate</h4><dl><dt>Kto</dt><dd>Narzędzia deterministyczne: analyzer i linty, formatter, reguły architektury, secret scan, dependency scan, golden testy</dd><dt>Wejście</dt><dd>Zmieniony kod</dd><dt>Wyjście</dt><dd>Pozytywny wynik albo dokładny błąd, który agent musi poprawić</dd><dt>Sprawdź</dt><dd>Pozytywny wynik znaczy, że kod jest poprawnie zbudowany, a nie że funkcja działa poprawnie</dd></dl></div>
		<div data-detail="tests"><h4>7. Testy</h4><dl><dt>Kto</dt><dd>Agent je pisze, narzędzia uruchamiają; ty sprawdzasz, czy testują kryteria, i osobiście uruchamiasz aplikację</dd><dt>Wejście</dt><dd>Kryteria i kod</dd><dt>Wyjście</dt><dd>Wyniki testów unit, widget i end-to-end oraz to, co widać na urządzeniu</dd><dt>Sprawdź</dt><dd>Czy test padnie, jeśli funkcja będzie zepsuta?</dd></dl></div>
		<div data-detail="docs"><h4>8. Dokumentacja</h4><dl><dt>Kto</dt><dd>Agent przygotowuje szkic; ty sprawdzasz</dd><dt>Wejście</dt><dd>Zmiana, decyzje podjęte w planie, to, co po drodze poszło nie tak</dd><dt>Wyjście</dt><dd>Zaktualizowana architektura, zapis decyzji, wpis w notatkach, <code>AGENTS.md</code>, jeśli zmieniła się jakaś reguła</dd><dt>Sprawdź</dt><dd>Dokumenty opisują kod taki, jaki jest teraz</dd></dl></div>
		<div data-detail="pr"><h4>9. Pull request</h4><dl><dt>Kto</dt><dd>Agent pisze szkic opisu; ty go poprawiasz i wysyłasz</dd><dt>Wejście</dt><dd>Commity, wyniki testów i gate'a, zmiany w dokumentacji</dd><dt>Wyjście</dt><dd>Co i dlaczego, jak zrobić review, dowody, zmienione dokumenty, pomoc AI</dd><dt>Sprawdź</dt><dd>Każde twierdzenie w opisie opiera się na wyniku, który masz przed oczami</dd></dl></div>
		<div data-detail="review"><h4>10. Review i merge</h4><dl><dt>Kto</dt><dd>Człowiek: twój partner albo inna para robi review, właściciel robi merge</dd><dt>Wejście</dt><dd>Pull request, architektura, zapisy decyzji, dziennik klienta</dd><dt>Wyjście</dt><dd>Zapis review i merge; wiedza opisuje teraz nową funkcję</dd><dt>Sprawdź</dt><dd>Checklista review; autor umie wyjaśnić każdą linię</dd></dl></div>
		<div data-detail="kb"><h4>Wiedza o projekcie</h4><dl><dt>Co</dt><dd>Dokumenty w repozytorium, które opisują system i to, dlaczego jest taki, jaki jest</dd><dt>Po co</dt><dd>Agent kodujący zaczyna każdą sesję, nie wiedząc nic o twoim projekcie. Z tych dokumentów poznaje architekturę, słowa klienta i wcześniejsze decyzje, zamiast je zgadywać.</dd><dt>Spróbuj</dt><dd>Kliknij dokument na mapie, żeby zobaczyć, które etapy go czytają.</dd></dl></div>
	</div>

	<div class="sdlc-layer-info">
		<div data-layer-info="audit"><h4>Ślad audytowy</h4><p>Każdy etap pokazuje teraz zapis, który po sobie zostawia. Kliknij etap, żeby zobaczyć jego zapis i prześledzić go wstecz po pasku audytowalności.</p></div>
		<div data-layer-info="loops"><h4>Pętle zwrotne</h4><dl><dt>Gate nie przechodzi</dt><dd>Dokładny błąd wraca do agenta, który poprawia kod.</dd><dt>Testy padają</dt><dd>Powrót do implementacji albo do planu, jeśli podejście było złe.</dd><dt>Prośba o zmiany</dt><dd>Reviewer odsyła pull request.</dd><dt>Niejasny plan</dt><dd>Jeśli planu nie da się zatwierdzić, winne są często niejasne kryteria: napisz je od nowa.</dd></dl><p>Pipeline jest narysowany z góry na dół, ale prawdziwa praca przebiega w pętlach. Im wcześniej zaczyna się pętla, tym jest tańsza.</p></div>
		<div data-layer-info="knowledge"><h4>Przepływy wiedzy</h4><p>Wiedza o projekcie zasila wymagania, <b>plan</b> i implementację. Na etapie dokumentacji aktualizujesz ją w tym samym pull requeście; po merge'u kolejna iteracja zaczyna się od zaktualizowanej wiedzy. Kliknij dokument, żeby zobaczyć, które dokładnie etapy go czytają.</p></div>
	</div>

	<div class="sdlc-kb-details">
		<div data-kb="architecture"><h4>Architektura: <code>ARCHITECTURE.md</code></h4><dl><dt>Co zawiera</dt><dd>Kontenery (aplikacja, API, baza danych), warstwy aplikacji (ekrany, providery, serwisy, dane, modele), co może importować co, jak płyną dane</dd><dt>Kto czyta</dt><dd>Analiza, wymagania, <b>plan</b> (gdzie trafi zmiana), implementacja, review (czy zmiana jej przestrzega?)</dd><dt>Aktualizacja</dt><dd>Na etapie 8, zawsze gdy zmienia się struktura</dd></dl></div>
		<div data-kb="decisions"><h4>Decyzje: <code>docs/adr/</code></h4><dl><dt>Co zawiera</dt><dd>Jeden zapis decyzji architektonicznej (ADR) na każdą decyzję: kontekst, decyzja, konsekwencje. Przykład: ADR-0002, ustawienia builda pochodzą z <code>--dart-define</code></dd><dt>Kto czyta</dt><dd><b>Plan</b> i review</dd><dt>Po co</dt><dd>Żeby agent ani nowe osoby w zespole nie rozstrzygały po cichu na nowo spraw, które już są ustalone</dd></dl></div>
		<div data-kb="notes"><h4>Notatki i dziennik pracy: <code>NOTES.md</code></h4><dl><dt>Co zawiera</dt><dd>Co zrobiono, co jest w toku, znane problemy i pułapki, na przykład „obrazy golden nagrano na macOS: nigdy nie generuj ich od nowa tylko po to, żeby test przeszedł”</dd><dt>Kto czyta</dt><dd><b>Plan</b> i implementacja</dd><dt>Po co</dt><dd>Kontekst agenta kończy się razem z sesją; notatki zostają</dd></dl></div>
		<div data-kb="product"><h4>Produkt i klient: <code>docs/product.md</code>, <code>docs/client-log.md</code></h4><dl><dt>Co zawiera</dt><dd>Karta produktu (klient, użytkownicy, intended purpose, ograniczenia, zakres) i to, co klient naprawdę powiedział</dd><dt>Kto czyta</dt><dd>Analiza, wymagania, <b>plan</b>, review</dd><dt>Po co</dt><dd>Dziennik klienta to jedyne źródło faktów o kliencie. Wszystko inne, od ciebie czy od agenta, to założenie</dd></dl></div>
		<div data-kb="api"><h4>README i dokumentacja API</h4><dl><dt>Co zawiera</dt><dd>Jak zbudować i uruchomić aplikację i serwer; kontrakt backendu: endpointy, pola, błędy (Swagger pod <code>/docs</code>)</dd><dt>Kto czyta</dt><dd>Wymagania, <b>plan</b>, implementacja</dd></dl></div>
		<div data-kb="agents"><h4><code>AGENTS.md</code></h4><dl><dt>Co zawiera</dt><dd>Zasady <em>pracy</em>: cykl, polecenia, reguły architektury, granice, raportowanie i to, gdzie leżą pozostałe dokumenty</dd><dt>Kto czyta</dt><dd>Prawie każdy etap: to punkt wejścia agenta</dd></dl></div>
	</div>

	<div class="sdlc-audits">
		<div data-audit="idea"><h4>Zapis audytowy: issue</h4><dl><dt>Zapis</dt><dd>Issue #7, „About screen”, ze szkicem</dd><dt>Gdzie</dt><dd>W issue trackerze</dd><dt>Odsyła do</dt><dd>Klienta, który o to poprosił, i wpisu w dzienniku klienta</dd></dl></div>
		<div data-audit="analysis"><h4>Zapis audytowy: GOAL-1</h4><dl><dt>Zapis</dt><dd>Definicja celu z ID, na które może się powołać cała reszta</dd><dt>Gdzie</dt><dd>W issue albo w <code>docs/goals/</code></dd><dt>Odsyła do</dt><dd>Issue #7</dd></dl></div>
		<div data-audit="requirements"><h4>Zapis audytowy: specyfikacja</h4><dl><dt>Zapis</dt><dd><code>docs/spec-about.md</code>, kryteria AC-1…AC-6, z GOAL-1 w nagłówku</dd><dt>Gdzie</dt><dd>W repozytorium, obok kodu</dd><dt>Odsyła do</dt><dd>GOAL-1 i <code>docs/client-log.md</code></dd></dl></div>
		<div data-audit="plan"><h4>Zapis audytowy: zatwierdzony plan</h4><dl><dt>Zapis</dt><dd>Plan, dokumenty, na których się oparł, i <b>twoje pisemne odpowiedzi</b> na jego pytania</dd><dt>Gdzie</dt><dd>W pull requeście albo w <code>docs/plans/</code></dd><dt>Odsyła do</dt><dd>AC-1…AC-6, ADR-0002, <code>ARCHITECTURE.md</code></dd></dl></div>
		<div data-audit="implementation"><h4>Zapis audytowy: commity</h4><dl><dt>Zapis</dt><dd>Małe commity z trailerami <code>Refs: GOAL-1</code> i <code>AI-assisted:</code></dd><dt>Gdzie</dt><dd>W historii Gita</dd><dt>Jak znaleźć</dt><dd><code>git log --grep="GOAL-1"</code></dd></dl></div>
		<div data-audit="gate"><h4>Zapis audytowy: log CI</h4><dl><dt>Zapis</dt><dd>Przebieg quality gate dla każdego commita: wersje narzędzi, wyniki</dd><dt>Gdzie</dt><dd>W GitHub Actions, z linkiem w pull requeście</dd><dt>Odsyła do</dt><dd>Dokładnie tego commita, który sprawdzał</dd></dl></div>
