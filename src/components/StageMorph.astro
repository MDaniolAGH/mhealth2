---

<div class="biz-widget morph not-content" data-stages={JSON.stringify(copy.stages)}>
	<p class="biz-kicker">{copy.kicker}</p>
	<div class="morph__steps" role="tablist">
		{
			copy.stages.map((s, k) => (
				<button type="button" role="tab" class={`morph__step is-${s.tone}`} data-i={k} aria-selected={k === 0 ? 'true' : 'false'}>
					<span class="morph__dot">{k + 1}</span>
					<span><b>{s.label}</b><small>{s.sub}</small></span>
				</button>
			))
		}
	</div>
	<p class="morph__prompt"><span>Prompt</span>{copy.prompt}</p>
	<div class="morph__grid">
		<div class="morph__col"><p class="morph__label">{copy.learned}</p><div class="morph__data"></div></div>
		<div class="morph__col">
			<p class="morph__label">{copy.writes}</p>
			<div class="morph__out" aria-live="polite"></div>
			<p class="morph__label">{copy.first}</p>
			<div class="morph__dist"></div>
		</div>
	</div>
	<p class="morph__moral" aria-live="polite"></p>
	<p class="morph__note">{copy.note}</p>
</div>

<script>
	const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.morph').forEach((box) => {
		const stages = JSON.parse(box.dataset.stages || '[]');
		const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('.morph__step'));
		const data = box.querySelector<HTMLElement>('.morph__data')!;
		const out = box.querySelector<HTMLElement>('.morph__out')!;
		const dist = box.querySelector<HTMLElement>('.morph__dist')!;
		const moral = box.querySelector<HTMLElement>('.morph__moral')!;
		let typing = 0;
		const show = (k: number) => {
			const s = stages[k];
			tabs.forEach((t, j) => { t.setAttribute('aria-selected', j === k ? 'true' : 'false'); t.classList.toggle('is-past', j < k); });
			box.dataset.tone = s.tone;
			data.innerHTML = s.data;
			moral.innerHTML = s.moral;
			dist.textContent = '';
			const max = Math.max(...s.dist.map((d: [string, number]) => d[1]));
			s.dist.forEach(([tok, p]: [string, number], j: number) => {
				const row = document.createElement('div');
				row.className = 'morph__bar' + (j === 0 ? ' is-top' : '');
				row.innerHTML = '<code></code><span><i></i></span><b></b>';
				row.querySelector('code')!.textContent = tok.replace(/ /g, '·');
				row.querySelector('b')!.textContent = `${Math.round(p * 100)}%`;
				dist.appendChild(row);
				requestAnimationFrame(() => ((row.querySelector('i') as HTMLElement).style.width = `${(p / max) * 100}%`));
			});
			out.textContent = '';
			const my = ++typing;
			s.out.forEach((tok: string, j: number) => {
				const add = () => {
					if (my !== typing) return;
					const span = document.createElement('span');
					span.className = 'morph__tok' + (tok.startsWith('〈') ? ' is-think' : '');
					span.textContent = tok;
					out.appendChild(span);
				};
				if (reduce) add(); else setTimeout(add, j * 70);
			});
		};
		tabs.forEach((t, k) => t.addEventListener('click', () => show(k)));
		show(0);
	});
</script>
