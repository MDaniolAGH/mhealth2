---
/** A row of the ten stages, coloured by who does the work, for the stage pages. */
import { link } from '../lib/url';
import { t, langOf } from '../i18n/ui';
const T = t(Astro);
const lang = langOf(Astro);

const stages = [
	['1', 'Idea', 'idea-to-plan/#stage-idea', 'you'],
	['2', 'Analysis', 'idea-to-plan/#stage-analysis', 'you'],
	['3', 'Requirements', 'idea-to-plan/#stage-requirements', 'you-agent'],
	['4', 'Plan', 'idea-to-plan/#stage-plan', 'you-agent'],
	['5', 'Implementation', 'code-and-gate/#stage-implementation', 'agent'],
	['6', 'Gate', 'code-and-gate/#stage-gate', 'tool'],
	['7', 'Tests', 'tests-to-merge/#stage-tests', 'agent-tool'],
	['8', 'Docs', 'tests-to-merge/#stage-docs', 'you-agent'],
	['9', 'PR', 'tests-to-merge/#stage-pr', 'you-agent'],
	['10', 'Review', 'tests-to-merge/#stage-review', 'you'],
];
---

<ul class="stage-strip not-content" aria-label="The ten stages">
	{
		stages.map(([n, label, path, who], i) => (
			<li>
				<a class={`is-${who}`} href={link(`ai-sdlc/${path}`, lang)}>
					<b>{n}</b> {T.stages[i]}
				</a>
			</li>
		))
	}
</ul>
